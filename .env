# Configurações para o Spring ler
# No Docker, usamos 'db' no lugar de 'localhost'
DB_URL=jdbc:mysql://db:3306/banco?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=root1

# Configurações para o Container do MySQL
MYSQL_ROOT_PASSWORD=root1
MYSQL_DATABASE=banco

# Servidor
SERVER_PORT=8081
update=update

JWT_SECRET=TroquePorUmaChaveMuitoGrandeESegura
JWT_EXPIRATION=3600000
JWT_ISSUER=bancoBrasilInvestidores

SESSION_TIMEOUT_MINUTES=30

SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=true

DB_HOST_TEST=localhost
DB_PORT_TEST=3306
DB_NAME_TEST=banco
DB_USER_TEST=root
DB_PASSWORD_TEST=root1